{%- comment -%}
  Polar Haircare — 08 Who It's For
  Features 4 use-case cards (For Women, For Men, For Busy Schedules, For Gentle Care).
{%- endcomment -%}

{%- if section.settings.enable_section -%}
  <section class="who-for-section" aria-label="Who It's For Use Cases">
    <div class="who-for-container">

      <!-- Section Header -->
      <div class="who-for-header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="who-for-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="who-for-title">
          {{ section.settings.heading | default: 'Whoever you are, it just works.' | escape }}
        </h2>

        <p class="who-for-subtitle">
          {{ section.settings.subheading | default: 'From first silver strands to stubborn edges and beards — Polar fits into your routine, not the other way around.' | escape }}
        </p>
      </div>

      <!-- 4 Cards Grid -->
      <div class="who-for-grid">

        <!-- Card 1: For Women -->
        <div class="who-for-card">
          <div class="who-for-img-wrap">
            {%- if section.settings.card_1_image != blank -%}
              <img src="{{ section.settings.card_1_image | image_url: width: 600 }}" alt="{{ section.settings.card_1_title | escape }}" class="who-for-img" loading="lazy">
            {%- else -%}
              <img src="{{ 'spotlight-caroline.png' | asset_url }}" alt="For Women" class="who-for-img" loading="lazy">
            {%- endif -%}
          </div>
          <div class="who-for-body">
            <span class="who-for-card-tag">{{ section.settings.card_1_tag | default: 'FOR WOMEN' }}</span>
            <h3 class="who-for-card-title">{{ section.settings.card_1_title | default: 'Roots, temples & full coverage' }}</h3>
            <p class="who-for-card-desc">{{ section.settings.card_1_desc | default: 'Blend first grays or cover them completely — with soft, natural-looking color that never looks flat or fake.' }}</p>
            <a href="{{ section.settings.card_1_link | default: routes.all_products_collection_url }}" class="who-for-card-link">
              Shop now →
            </a>
          </div>
        </div>

        <!-- Card 2: For Men -->
        <div class="who-for-card">
          <div class="who-for-img-wrap">
            {%- if section.settings.card_2_image != blank -%}
              <img src="{{ section.settings.card_2_image | image_url: width: 600 }}" alt="{{ section.settings.card_2_title | escape }}" class="who-for-img" loading="lazy">
            {%- else -%}
              <img src="{{ 'before_after.jpg' | asset_url }}" alt="For Men" class="who-for-img" loading="lazy">
            {%- endif -%}
          </div>
          <div class="who-for-body">
            <span class="who-for-card-tag">{{ section.settings.card_2_tag | default: 'FOR MEN' }}</span>
            <h3 class="who-for-card-title">{{ section.settings.card_2_title | default: 'Hair and beards, in one bottle' }}</h3>
            <p class="who-for-card-desc">{{ section.settings.card_2_desc | default: 'Works just as well on beards. A subtle, natural refresh without a trip to the salon or barber.' }}</p>
            <a href="{{ section.settings.card_2_link | default: routes.all_products_collection_url }}" class="who-for-card-link">
              Shop now →
            </a>
          </div>
        </div>

        <!-- Card 3: For Busy Schedules -->
        <div class="who-for-card">
          <div class="who-for-img-wrap">
            {%- if section.settings.card_3_image != blank -%}
              <img src="{{ section.settings.card_3_image | image_url: width: 600 }}" alt="{{ section.settings.card_3_title | escape }}" class="who-for-img" loading="lazy">
            {%- else -%}
              <img src="{{ 'customer_story.jpg' | asset_url }}" alt="For Busy Schedules" class="who-for-img" loading="lazy">
            {%- endif -%}
          </div>
          <div class="who-for-body">
            <span class="who-for-card-tag">{{ section.settings.card_3_tag | default: 'FOR BUSY SCHEDULES' }}</span>
            <h3 class="who-for-card-title">{{ section.settings.card_3_title | default: '10 minutes, done in the shower' }}</h3>
            <p class="who-for-card-desc">{{ section.settings.card_3_desc | default: 'No appointments, bowls or brushes. Color your hair at home whenever it suits you.' }}</p>
            <a href="{{ section.settings.card_3_link | default: routes.all_products_collection_url }}" class="who-for-card-link">
              Shop now →
            </a>
          </div>
        </div>

        <!-- Card 4: For Gentle Care -->
        <div class="who-for-card">
          <div class="who-for-img-wrap">
            {%- if section.settings.card_4_image != blank -%}
              <img src="{{ section.settings.card_4_image | image_url: width: 600 }}" alt="{{ section.settings.card_4_title | escape }}" class="who-for-img" loading="lazy">
            {%- else -%}
              <img src="{{ 'polar_shampoo.jpg' | asset_url }}" alt="For Gentle Care" class="who-for-img" loading="lazy">
            {%- endif -%}
          </div>
          <div class="who-for-body">
            <span class="who-for-card-tag">{{ section.settings.card_4_tag | default: 'FOR GENTLE CARE' }}</span>
            <h3 class="who-for-card-title">{{ section.settings.card_4_title | default: 'Ammonia-free, plant-powered' }}</h3>
            <p class="who-for-card-desc">{{ section.settings.card_4_desc | default: 'Reishi, black sesame, ginseng and fo-ti help keep hair soft, shiny and healthy-feeling.' }}</p>
            <a href="{{ section.settings.card_4_link | default: routes.all_products_collection_url }}" class="who-for-card-link">
              Shop now →
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>
{%- endif -%}

