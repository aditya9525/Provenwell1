                  <div class="proof-review-stars" aria-label="5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <p class="proof-review-quote">{{ section.settings.card_3_quote | default: '“Quick and easy. Color looks really good. No staining on hairline or face / ears. Love this product.”' }}</p>
                  <div class="proof-review-footer">
                    <span class="proof-review-author">{{ section.settings.card_3_author | default: 'Priadashni T., Boston, MA' }}</span>
                    <span class="proof-verified-badge">
                      <svg class="proof-verified-icon" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                      </svg>
