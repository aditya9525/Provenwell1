  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const sectionEl = document.getElementById('resultsCarousel');
      if (!sectionEl) return;

      const swiperContainer = sectionEl.querySelector('.results-swiper');
      const tabBtns = sectionEl.querySelectorAll('.results-tab-btn');
      const allSlides = Array.from(sectionEl.querySelectorAll('.result-card-slide'));

      let swiperInstance = new Swiper(swiperContainer, {
        slidesPerView: 1.15,
        spaceBetween: 16,
        grabCursor: true,
        watchOverflow: true,
        pagination: {
          el: sectionEl.querySelector('.results-swiper-pagination'),
          clickable: true,
          renderBullet: function(index, className) {
            return '<span class="' + className + ' results-pill-bullet"></span>';
          }
        },
        breakpoints: {
          480: {
            slidesPerView: 1.6,
            spaceBetween: 16
          },
          768: {
            slidesPerView: 2.5,
            spaceBetween: 20
          },
          1024: {
            slidesPerView: 3.5,
            spaceBetween: 24
          },
          1200: {
            slidesPerView: 5.9,
            spaceBetween: 24
          }
        }
      });

      // Filter tabs logic
      function filterCategory(category) {
        allSlides.forEach(function(slide) {
          const slideCategory = slide.getAttribute('data-category');
          if (category === 'all' || slideCategory === category) {
            slide.style.display = '';
          } else {
            slide.style.display = 'none';
          }
        });

        if (swiperInstance) {
          swiperInstance.update();
          swiperInstance.slideTo(0);
        }
      }

      // Initial filter to active tab
      const activeTab = sectionEl.querySelector('.results-tab-btn.active');
      if (activeTab) {
        filterCategory(activeTab.getAttribute('data-tab'));
      }

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          tabBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          const tab = btn.getAttribute('data-tab');
          filterCategory(tab);
        });
      });
    });
  </script>
