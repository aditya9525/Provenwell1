{%- comment -%}
  Shopify Section: The Results Speak For Themselves (Swiper.js Reviews Carousel)
  Features Women's & Men's toggle tabs, Swiper.js touch carousel, custom pill pagination, and dynamic blocks.
{%- endcomment -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

{%- if section.settings.enable_section -%}
  <section class="results-carousel-section" id="resultsCarousel" aria-label="Customer Results Carousel">
    <div class="results-carousel-container">

      <!-- Top 5 Gold Star Icon Badge -->
      <div class="results-top-stars" aria-label="5 out of 5 stars">
        <span class="star-icon">&#9733;</span>
        <span class="star-icon">&#9733;</span>
        <span class="star-icon">&#9733;</span>
        <span class="star-icon">&#9733;</span>
        <span class="star-icon">&#9733;</span>
      </div>

      <!-- Main Heading -->
      {%- if section.settings.heading != blank -%}
        <h2 class="results-main-title">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <!-- Gender Results Toggle Filter Tabs -->
      <div class="results-tabs-wrapper" role="tablist" aria-label="Results Category Tabs">
        <button type="button" class="results-tab-btn active" role="tab" aria-selected="true" data-tab="women">
          {{ section.settings.tab_women_label | default: "WOMEN’S RESULTS" | escape }}
        </button>
        <button type="button" class="results-tab-btn" role="tab" aria-selected="false" data-tab="men">
          {{ section.settings.tab_men_label | default: "MEN’S RESULTS" | escape }}
        </button>
      </div>

      <!-- Swiper Carousel Container -->
      <div class="swiper results-swiper" id="resultsSwiper">
        <div class="swiper-wrapper">
          
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="swiper-slide result-card-slide" data-category="{{ block.settings.category | default: 'women' }}" {{ block.shopify_attributes }}>
                <div class="result-card">
                  
                  <!-- Card Image with Before/After Overlays -->
                  <div class="result-card-media">
                    {%- if block.settings.image != blank -%}
                      <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.author | default: 'Customer Result' | escape }}" class="result-img" loading="lazy">
                    {%- else -%}
                      <img src="{{ 'spotlight-caroline.png' | asset_url }}" alt="Before and After Result" class="result-img" loading="lazy">
                    {%- endif -%}
                    
                    <div class="result-badge-overlay">
                      <span class="badge-pill before-pill">BEFORE</span>
                      <span class="badge-pill after-pill">AFTER</span>
                    </div>
                  </div>

                  <!-- Card Review Details -->
                  <div class="result-card-body">
                    <div class="result-card-stars" aria-label="5 Star Rating">
                      <span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span><span>&#9733;</span>
                    </div>

                    <p class="result-card-quote">
                      {{ block.settings.quote | escape }}
                    </p>

                    <div class="result-card-footer">
                      <span class="result-author">{{ block.settings.author | escape }}</span>
                      
                      {%- if block.settings.verified -%}
                        <div class="verified-pill">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                          <span>VERIFIED BUYER</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>

                </div>
              </div>
            {%- endfor -%}
