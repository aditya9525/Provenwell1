<!-- 09 — Offer / Choose Your Bundle Section -->
<section class="bundle-offer-section" id="bundleOfferSection" aria-labelledby="bundleOfferTitle">
  <div class="bundle-offer-container">

    <!-- Section Heading -->
    <div class="bundle-offer-header">
      <div class="bundle-sale-pill">
        <span>FALL SALE EXCLUSIVE</span>
      </div>
      <h2 class="bundle-offer-title" id="bundleOfferTitle">Choose your bundle &amp; save</h2>
      <p class="bundle-offer-subtitle">
        Each bottle gives you 15 applications. Stock up and unlock free shipping and a free conditioner.
      </p>
    </div>

    {%- liquid
      assign v1 = product.variants[0]
      assign v2 = product.variants[1]
      assign v3 = product.variants[2]

      assign v1_price = v1.price | default: 350000
      assign v1_compare = v1.compare_at_price | default: 490000
      assign v1_save = 29
      if v1_compare != blank and v1_compare > v1_price
        assign v1_save = v1_compare | minus: v1_price | times: 100.0 | divided_by: v1_compare | round
      endif

      assign v2_price = v2.price | default: 295000
      assign v2_compare = v2.compare_at_price | default: 490000
      assign v2_save = 40
      if v2_compare != blank and v2_compare > v2_price
        assign v2_save = v2_compare | minus: v2_price | times: 100.0 | divided_by: v2_compare | round
      endif

      assign v3_price = v3.price | default: 233300
      assign v3_compare = v3.compare_at_price | default: 490000
      assign v3_save = 52
      if v3_compare != blank and v3_compare > v3_price
        assign v3_save = v3_compare | minus: v3_price | times: 100.0 | divided_by: v3_compare | round
      endif
    -%}

    <!-- Bundles Grid / Cards Row -->
    <div class="bundle-cards-row">

      <!-- Bundle Card 1: 1 Bottle -->
      <div class="bundle-item-card bundle-card-1">
        <div class="bundle-card-top">
          <div class="bundle-img-box">
            <img src="{{ 'bundle-1-bottle.png' | asset_url }}" alt="1 Bottle - Polar Instant Dye Shampoo" class="bundle-bottle-img" loading="lazy">
          </div>
          <div class="bundle-card-info">
            <h3 class="bundle-item-title">{{ v1.title | default: '1 Bottle' }}</h3>
            <div class="bundle-price-row">
              {%- if v1_compare != blank and v1_compare > v1_price -%}
                <span class="bundle-price-compare">{{ v1_compare | money_without_trailing_zeros | remove: '.00' }}</span>
              {%- else -%}
                <span class="bundle-price-compare">Rs. 4,900</span>
              {%- endif -%}
              <span class="bundle-price-current">{{ v1_price | money_without_trailing_zeros | remove: '.00' }}</span>
              <span class="bundle-price-unit">/ bottle</span>
            </div>
            <div class="bundle-save-tag">
              <span>Save {{ v1_save | default: 29 }}% &middot; Total {{ v1_price | money_without_trailing_zeros | remove: '.00' }}</span>
            </div>
          </div>
        </div>

        <div class="bundle-divider"></div>

        <ul class="bundle-perks-list">
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text">15 applications</span>
          </li>
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text">Covers grays in 10 minutes</span>
          </li>
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text">30-day money-back guarantee</span>
          </li>
        </ul>

        <button type="button" class="bundle-btn bundle-btn-primary" data-variant-id="{{ v1.id }}" data-bundle-qty="1" data-bundle-price="{{ v1_price }}" aria-label="Add 1 Bottle bundle to cart">
          <span>ADD TO CART</span>
        </button>
      </div>

      <!-- Bundle Card 2: 2 Bottles (Featured / Most Popular) -->
      <div class="bundle-item-card bundle-featured-card bundle-card-2">
        <div class="bundle-card-top">
          <div class="bundle-badge bundle-badge-white">
            <span>MOST POPULAR</span>
          </div>
          <div class="bundle-img-box">
            <img src="{{ 'bundle-2-bottles.png' | asset_url }}" alt="2 Bottles - Polar Instant Dye Shampoo" class="bundle-bottle-img" loading="lazy">
          </div>
          <div class="bundle-card-info">
            <div class="bundle-mobile-badge bundle-badge-white">
              <span>MOST POPULAR</span>
            </div>
            <h3 class="bundle-item-title bundle-title-light">{{ v2.title | default: '2 Bottles' }}</h3>
            <div class="bundle-price-row">
              {%- if v2_compare != blank and v2_compare > v2_price -%}
                <span class="bundle-price-compare bundle-light">{{ v2_compare | money_without_trailing_zeros | remove: '.00' }}</span>
              {%- else -%}
                <span class="bundle-price-compare bundle-light">Rs. 4,900</span>
              {%- endif -%}
              <span class="bundle-price-current bundle-light">{{ v2_price | money_without_trailing_zeros | remove: '.00' }}</span>
              <span class="bundle-price-unit bundle-light">/ bottle</span>
            </div>
            <div class="bundle-save-tag bundle-save-tag-glass">
              <span>Save {{ v2_save | default: 40 }}% &middot; Total {{ v2_price | times: 2 | default: 590000 | money_without_trailing_zeros | remove: '.00' }}</span>
            </div>
          </div>
        </div>

        <div class="bundle-divider bundle-divider-light"></div>

        <ul class="bundle-perks-list">
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text bundle-text-light">30 applications</span>
          </li>
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text bundle-text-light">+ Free shipping</span>
          </li>
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text bundle-text-light">30-day money-back guarantee</span>
          </li>
        </ul>

        <button type="button" class="bundle-btn bundle-btn-inverse" data-variant-id="{{ v2.id }}" data-bundle-qty="2" data-bundle-price="{{ v2_price | times: 2 | default: 590000 }}" aria-label="Add 2 Bottles bundle to cart">
          <span>ADD TO CART</span>
        </button>
      </div>

      <!-- Bundle Card 3: 3 Bottles (Best Value) -->
      <div class="bundle-item-card bundle-card-3">
        <div class="bundle-card-top">
          <div class="bundle-badge bundle-badge-dark">
            <span>BEST VALUE</span>
          </div>
          <div class="bundle-img-box">
            <img src="{{ 'bundle-3-bottles.png' | asset_url }}" alt="3 Bottles - Polar Instant Dye Shampoo" class="bundle-bottle-img" loading="lazy">
          </div>
          <div class="bundle-card-info">
            <div class="bundle-mobile-badge bundle-badge-dark">
              <span>BEST VALUE</span>
            </div>
            <h3 class="bundle-item-title">{{ v3.title | default: '3 Bottles' }}</h3>
            <div class="bundle-price-row">
              {%- if v3_compare != blank and v3_compare > v3_price -%}
                <span class="bundle-price-compare">{{ v3_compare | money_without_trailing_zeros | remove: '.00' }}</span>
              {%- else -%}
                <span class="bundle-price-compare">Rs. 4,900</span>
              {%- endif -%}
              <span class="bundle-price-current">{{ v3_price | money_without_trailing_zeros | remove: '.00' }}</span>
              <span class="bundle-price-unit">/ bottle</span>
            </div>
            <div class="bundle-save-tag">
              <span>Save {{ v3_save | default: 52 }}% &middot; Total {{ v3_price | times: 3 | default: 699900 | money_without_trailing_zeros | remove: '.00' }}</span>
            </div>
          </div>
        </div>

        <div class="bundle-divider"></div>

        <ul class="bundle-perks-list">
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text">45 applications</span>
          </li>
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text">+ Free shipping</span>
          </li>
          <li class="bundle-perk-item">
            <span class="bundle-check-icon" aria-hidden="true">
              <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
                <circle cx="9" cy="9" r="9" fill="#2FA60F" />
                <path d="M5.5 9.2L7.8 11.5L12.5 6.8" stroke="#FFFFFF" stroke-width="1.88" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="bundle-perk-text">+ Free conditioner</span>
          </li>
        </ul>

        <button type="button" class="bundle-btn bundle-btn-primary" data-bundle-qty="3" data-bundle-price="{{ v3_price | times: 3 | default: 699900 }}" aria-label="Add 3 Bottles bundle to cart">
          <span>ADD TO CART</span>
        </button>
      </div>

    </div>

