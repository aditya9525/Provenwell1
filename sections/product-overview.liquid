{%- comment -%}
  Polar Haircare — 04 Product / Solution Overview Section
  Features product callout visual card, eyebrow, heading, description, 6 checkmark benefits,
  4-column spec table, shade swatch selectors, and primary & secondary CTA buttons.
{%- endcomment -%}

<section class="product-overview-section" aria-label="Product Solution Overview">
  <div class="product-overview-container">

    <!-- Left Column: Product Feature Callouts Visual Card -->
    <div class="product-overview-visual-col">
      <div class="product-overview-card">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1120 | image_tag: 
            class: 'product-overview-card-img', 
            loading: 'lazy', 
            alt: section.settings.heading | default: 'Polar Instant Dye Shampoo Feature Callouts' 
          }}
        {%- else -%}
          <img
            src="{{ 'product-feature-callout.png' | asset_url }}"
            alt="Polar Instant Dye Shampoo - Product Features and 840,000+ Happy Customers"
            class="product-overview-card-img"
            loading="lazy"
            width="560"
            height="560"
          >
        {%- endif -%}
      </div>
    </div>

    <!-- Right Column: Product Copy, Checklist, Specs, Swatches & CTAs -->
    <div class="product-overview-copy-col">

      <!-- Eyebrow -->
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-overview-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <!-- Main Headline -->
      <h2 class="product-overview-title">
        {{ section.settings.heading | default: 'Instant Dye Shampoo — one bottle, 15 full applications.' }}
      </h2>

      <!-- Description Body -->
      <p class="product-overview-desc">
        {{ section.settings.description | default: "A color-depositing shampoo powered by botanicals like Ganoderma (reishi), black sesame, ginseng and fo-ti. Apply to dry hair, wait 10 minutes, rinse — that's it." }}
      </p>

      <!-- Feature Checklist (6 items) -->
      <ul class="product-overview-checklist">
        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">{{ section.settings.feature_1 | default: 'Full gray coverage' }}</span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">{{ section.settings.feature_2 | default: 'Results in just 10 minutes' }}</span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">{{ section.settings.feature_3 | default: 'No stains, gloves or mixing' }}</span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">{{ section.settings.feature_4 | default: 'Gentle on scalp, ammonia-free' }}</span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">{{ section.settings.feature_5 | default: 'Color lasts 4–6 weeks' }}</span>
        </li>

        <li class="product-overview-check-item">
          <span class="product-overview-check-icon" aria-hidden="true">
            <svg viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1.5 5 4.5 8 10.5 2"></polyline>
            </svg>
          </span>
          <span class="product-overview-check-text">{{ section.settings.feature_6 | default: 'Works on hair and beards' }}</span>
        </li>
      </ul>

      <!-- Spec Table (4 columns) -->
      <div class="product-overview-spec-table">
        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">{{ section.settings.spec_1_label | default: 'SIZE' }}</span>
          <span class="product-overview-spec-val">{{ section.settings.spec_1_val | default: '200 ml / 6.76 fl oz' }}</span>
        </div>

        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">{{ section.settings.spec_2_label | default: 'USES / BOTTLE' }}</span>
          <span class="product-overview-spec-val">{{ section.settings.spec_2_val | default: '15' }}</span>
        </div>

        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">{{ section.settings.spec_3_label | default: 'SHADES' }}</span>
          <span class="product-overview-spec-val">{{ section.settings.spec_3_val | default: 'Black · Dark · Med. Brown' }}</span>
        </div>

        <div class="product-overview-spec-cell">
          <span class="product-overview-spec-label">{{ section.settings.spec_4_label | default: 'FORMULA' }}</span>
          <span class="product-overview-spec-val">{{ section.settings.spec_4_val | default: 'Ammonia-free' }}</span>
        </div>
      </div>

      <!-- Shade Swatches -->
      <div class="product-overview-swatches" role="radiogroup" aria-label="Select Hair Shade">
        <button type="button" class="product-swatch-btn is-active" role="radio" aria-checked="true" aria-label="Shade Black" data-shade="black">
          <span class="product-swatch-thumb-wrap">
            <img src="{{ 'swatch-black.png' | asset_url }}" alt="Black Shade Swatch" class="product-swatch-img" width="74" height="74" loading="lazy">
          </span>
          <span class="product-swatch-title">Black</span>
        </button>

        <button type="button" class="product-swatch-btn" role="radio" aria-checked="false" aria-label="Shade Dark Brown" data-shade="dark-brown">
          <span class="product-swatch-thumb-wrap">
            <img src="{{ 'swatch-dark-brown.png' | asset_url }}" alt="Dark Brown Shade Swatch" class="product-swatch-img" width="74" height="74" loading="lazy">
          </span>
          <span class="product-swatch-title">Dark Brown</span>
        </button>

        <button type="button" class="product-swatch-btn" role="radio" aria-checked="false" aria-label="Shade Medium Brown" data-shade="medium-brown">
          <span class="product-swatch-thumb-wrap">
            <img src="{{ 'swatch-medium-brown.png' | asset_url }}" alt="Medium Brown Shade Swatch" class="product-swatch-img" width="74" height="74" loading="lazy">
          </span>
          <span class="product-swatch-title">Medium Brown</span>
        </button>
      </div>

      <!-- CTAs Row -->
      <div class="product-overview-ctas">
        <a href="{{ section.settings.btn_1_link | default: routes.all_products_collection_url }}" class="product-overview-btn-primary">
          {{ section.settings.btn_1_text | default: 'Add to Cart — Rs. 3,500' }}
        </a>

        <a href="{{ section.settings.btn_2_link | default: '#shade-guide' }}" class="product-overview-btn-secondary">
          {{ section.settings.btn_2_text | default: 'Find Your Shade' }}
        </a>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
