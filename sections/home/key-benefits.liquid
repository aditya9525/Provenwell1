{%- comment -%}
  Polar Haircare — Make Hair Coloring Simple & Hassle-Free Section
{%- endcomment -%}

{%- if section.settings.enable_section -%}
  <section class="make-simple-section" id="makeSimpleSection" aria-labelledby="makeSimpleTitle">
    <div class="make-simple-container">

      <!-- Section Heading (Desktop + Mobile Responsive) -->
      <div class="make-simple-header">
        <span class="make-simple-eyebrow">{{ section.settings.eyebrow_text | default: "GET NATURAL, LASTING COLOR IN JUST 10 MINUTES" }}</span>
        <h2 class="make-simple-title-desktop" id="makeSimpleTitle">
          <span class="title-top">{{ section.settings.title_top | default: "Make Hair Coloring" }}</span>
          <span class="title-main">{{ section.settings.title_main | default: "SIMPLE & HASSLE-FREE" }}</span>
        </h2>
        <h2 class="make-simple-title-mobile">{{ section.settings.mobile_title | default: "Make hair coloring simple & hassle-free" }}</h2>
        <p class="make-simple-subtitle">{{ section.settings.subtitle | default: "Get natural, lasting color in just 10 minutes" }}</p>
      </div>

      <!-- Desktop Dark Purple Banner with Overlapping Video Card -->
      <div class="make-simple-banner">

        <!-- Video Thumbnail Card (Desktop & Mobile trigger) -->
        <div class="make-simple-video-wrap">
          <div class="make-simple-video-card js-open-simple-video" role="button" tabindex="0"
            aria-label="Play demonstration video">
            {%- if section.settings.poster_image != blank -%}
              <img src="{{ section.settings.poster_image | image_url: width: 1200 }}" alt="{{ section.settings.title_top | escape }}" class="make-simple-video-poster" loading="lazy">
            {%- else -%}
              <img src="{{ 'customer_story.jpg' | asset_url }}" alt="Make Hair Coloring Simple Video" class="make-simple-video-poster" loading="lazy">
            {%- endif -%}
            <div class="make-simple-play-btn" aria-hidden="true">
              <svg width="22" height="24" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="6 3 20 12 6 21 6 3"></polygon>
              </svg>
            </div>
          </div>
        </div>

        <!-- Desktop 4-Feature Row (inside the banner) -->
        <div class="make-simple-features-desktop">

          <!-- Feature 1 -->
          <div class="simple-feature-item">
            <div class="simple-feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="13" r="8"></circle>
                <path d="M12 9v4l2.5 1.5"></path>
                <path d="M10 2h4"></path>
                <path d="M12 2v3"></path>
              </svg>
            </div>
            <h3 class="simple-feature-title">{{ section.settings.card_1_title | default: "WORKS IN JUST 10 MINUTES" }}</h3>
            <p class="simple-feature-desc">{{ section.settings.card_1_desc | default: "Apply to dry hair, wait 10 minutes, and rinse. It’s that easy." }}</p>
          </div>

          <!-- Feature 2 -->
          <div class="simple-feature-item">
            <div class="simple-feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
              </svg>
            </div>
            <h3 class="simple-feature-title">{{ section.settings.card_2_title | default: "QUICK, MESS-FREE APPLICATION" }}</h3>
            <p class="simple-feature-desc">{{ section.settings.card_2_desc | default: "No mixing, no gloves, no stains. Works just like your regular shampoo." }}</p>
          </div>

          <!-- Feature 3 -->
          <div class="simple-feature-item">
            <div class="simple-feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
              </svg>
            </div>
            <h3 class="simple-feature-title">{{ section.settings.card_3_title | default: "CONTAINS NATURAL INGREDIENTS" }}</h3>
            <p class="simple-feature-desc">{{ section.settings.card_3_desc | default: "Like reishi mushrooms, without harsh chemicals like ammonia." }}</p>
          </div>

          <!-- Feature 4 -->
          <div class="simple-feature-item">
            <div class="simple-feature-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="6.5" r=".5" fill="#FFFFFF"></circle>
                <circle cx="17.5" cy="10.5" r=".5" fill="#FFFFFF"></circle>
                <circle cx="8.5" cy="7.5" r=".5" fill="#FFFFFF"></circle>
                <circle cx="6.5" cy="12.5" r=".5" fill="#FFFFFF"></circle>
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2Z"></path>
              </svg>
            </div>
            <h3 class="simple-feature-title">{{ section.settings.card_4_title | default: "LONG-LASTING NATURAL COLOR" }}</h3>
            <p class="simple-feature-desc">{{ section.settings.card_4_desc | default: "Each application lasts up to 6 weeks, keeping grays hidden longer." }}</p>
          </div>

        </div>
      </div>

      <!-- Mobile 2x2 Feature Cards Grid -->
      <div class="make-simple-features-mobile">

        <!-- Mobile Card 1 -->
        <div class="simple-mob-card">
          <div class="simple-mob-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="13" r="8"></circle>
              <path d="M12 9v4l2.5 1.5"></path>
              <path d="M10 2h4"></path>
              <path d="M12 2v3"></path>
            </svg>
          </div>
          <h4 class="simple-mob-title">Works in just 10 minutes</h4>
          <p class="simple-mob-desc">Apply to dry hair, wait 10 minutes, and rinse.</p>
        </div>

        <!-- Mobile Card 2 -->
        <div class="simple-mob-card">
          <div class="simple-mob-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
            </svg>
          </div>
          <h4 class="simple-mob-title">Quick, mess-free</h4>
          <p class="simple-mob-desc">No mixing, no gloves, no stains.</p>
        </div>

        <!-- Mobile Card 3 -->
        <div class="simple-mob-card">
          <div class="simple-mob-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
          </div>
          <h4 class="simple-mob-title">Natural ingredients</h4>
          <p class="simple-mob-desc">Reishi mushroom, without ammonia.</p>
        </div>

        <!-- Mobile Card 4 -->
        <div class="simple-mob-card">
          <div class="simple-mob-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13.5" cy="6.5" r=".5" fill="#FFFFFF"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="#FFFFFF"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="#FFFFFF"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="#FFFFFF"></circle>
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2Z"></path>
            </svg>
          </div>
          <h4 class="simple-mob-title">Long-lasting color</h4>
          <p class="simple-mob-desc">Each application lasts up to 6 weeks.</p>
        </div>

      </div>

    </div>
  </section>

  <!-- Video Popup Modal -->
  <div class="make-simple-modal-overlay" id="simpleVideoModal" aria-hidden="true" role="dialog" aria-label="Product Demo Video Modal">
    <div class="make-simple-modal-container">
      <button class="make-simple-modal-close-btn js-close-simple-video" aria-label="Close video player">&times;</button>
      <div class="make-simple-modal-player-wrapper">
        <video id="simpleVideoPlayer" controls playsinline preload="metadata">
          <source src="{{ section.settings.video_url | default: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4' }}" type="video/mp4">
          Your browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const openBtns = document.querySelectorAll('.js-open-simple-video');
      const modal = document.getElementById('simpleVideoModal');
      const closeBtn = modal?.querySelector('.js-close-simple-video');
      const video = document.getElementById('simpleVideoPlayer');

      function openModal() {
        if (!modal) return;
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        if (video) {
          video.currentTime = 0;
          video.play().catch(function() {});
        }
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (video) {
          video.pause();
        }
      }

      openBtns.forEach(function(btn) {
        btn.addEventListener('click', openModal);
        btn.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModal();
          }
        });
      });

      closeBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal?.classList.contains('active')) {
          closeModal();
        }
      });
    });
  </script>
{%- endif -%}

