          {%- endif -%}

        </div>

        <!-- Swiper Pagination (Mobile Only) -->
        <div class="swiper-pagination proof-trust-reviews-pagination"></div>
      </div>

    </div>
  </section>

  <script>
    (function() {
      function loadSwiperScript(callback) {
        if (typeof Swiper !== 'undefined') {
          callback();
          return;
        }
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.onload = callback;
        document.head.appendChild(script);
      }

      var proofSwiper = null;

      function initSwiper() {
        var container = document.getElementById('proofReviewsSwiper-{{ section.id }}');
        if (!container || typeof Swiper === 'undefined') return;

        if (proofSwiper) {
          proofSwiper.update();
          return;
        }

        proofSwiper = new Swiper(container, {
          slidesPerView: 'auto',
          spaceBetween: 12,
          slidesOffsetBefore: 16,
          slidesOffsetAfter: 16,
          grabCursor: true,
          watchOverflow: true,
          observer: true,
          observeParents: true,
          pagination: {
            el: container.querySelector('.proof-trust-reviews-pagination'),
            clickable: true,
          },
          breakpoints: {
            640: {
              slidesPerView: 2,
              spaceBetween: 16,
              slidesOffsetBefore: 0,
              slidesOffsetAfter: 0,
            },
            900: {
              slidesPerView: 3,
              spaceBetween: 20,
              slidesOffsetBefore: 0,
              slidesOffsetAfter: 0,
            },
            1100: {
              slidesPerView: 4,
              spaceBetween: 24,
              slidesOffsetBefore: 0,
              slidesOffsetAfter: 0,
            }
          }
        });
      }

      loadSwiperScript(function() {
        initSwiper();
      });

      document.addEventListener('shopify:section:load', function(e) {
        if (e.target && (e.target.id === 'shopify-section-{{ section.id }}' || e.target.querySelector('#proofReviewsSwiper-{{ section.id }}'))) {
          loadSwiperScript(initSwiper);
        }
      });

      document.addEventListener('shopify:block:select', function(e) {
        if (proofSwiper && e.target && e.target.classList.contains('proof-review-slide')) {
          var slides = Array.from(e.target.parentNode.children);
          var index = slides.indexOf(e.target);
          if (index !== -1) {
            proofSwiper.slideTo(index);
          }
        }
      });
    })();
  </script>
{%- endif -%}

