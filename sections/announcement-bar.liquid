{{ 'style.css' | asset_url | stylesheet_tag }}
{% style %}
  .announcement-bar {
    width: 100%;
    background-color: {{ section.settings.bg_color | default: '#1E2123' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: 'rgba(244, 244, 244, 0.08)' }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1010;
  }

  .announcement-container {
    width: 100%;
    max-width: 1260px;
    margin: 0 auto;
    padding: 10.5px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  .announcement-text {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.text_color | default: '#F4F4F4' }};
    margin: 0;
  }

  .announcement-link {
    text-decoration: none;
    color: inherit;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .announcement-container {
      padding: 8px 12px;
    }
    .announcement-text {
      font-size: 11px;
      letter-spacing: 1.5px;
    }
  }
{% endstyle %}

{%- if section.settings.show_announcement and section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    <div class="announcement-container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-link">
          <span class="announcement-text">{{ section.settings.text | escape }}</span>
        </a>
      {%- else -%}
        <p class="announcement-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "FALL SALE IS LIVE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1E2123"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "rgba(244, 244, 244, 0.08)"
    }
  ]
}
{% endschema %}
