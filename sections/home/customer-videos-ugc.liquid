<!-- 11 — Customer Videos (UGC) Section -->
<section class="ugc-videos-section" id="customerVideosSection" aria-labelledby="ugcVideosHeading">
  <div class="ugc-videos-container">

    <!-- Section Heading -->
    <div class="ugc-videos-header">
      <h2 class="ugc-videos-title" id="ugcVideosHeading">
        {{ section.settings.title | default: "Over 840,000+ Happy Customers Have Made The Switch" }}
      </h2>
      <p class="ugc-videos-subtitle">
        {{ section.settings.subtitle | default: "Real people, real bathrooms, real 10-minute results." }}
      </p>
    </div>

    <!-- Swiper Carousel Container for Customer Videos -->
    <div class="ugc-swiper-wrapper-outer">
      <div class="swiper ugc-videos-swiper" id="ugcVideosSwiper">
        <div class="swiper-wrapper">

          <!-- Video Slide 1 -->
          <div class="swiper-slide ugc-video-slide">
            <div class="ugc-video-card" role="button" tabindex="0" aria-label="Play Customer Video 1">
              <img src="../assets/ugc-customer-1.png" alt="Customer Video Review 1 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
              <div class="ugc-play-btn-circle" aria-hidden="true">
                <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                  <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#2C3452"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Video Slide 2 -->
          <div class="swiper-slide ugc-video-slide">
            <div class="ugc-video-card" role="button" tabindex="0" aria-label="Play Customer Video 2">
              <img src="../assets/ugc-customer-2.png" alt="Customer Video Review 2 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
              <div class="ugc-play-btn-circle" aria-hidden="true">
                <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                  <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#2C3452"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Video Slide 3 -->
          <div class="swiper-slide ugc-video-slide">
            <div class="ugc-video-card" role="button" tabindex="0" aria-label="Play Customer Video 3">
              <img src="../assets/ugc-customer-3.png" alt="Customer Video Review 3 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
              <div class="ugc-play-btn-circle" aria-hidden="true">
                <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                  <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#2C3452"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Video Slide 4 -->
          <div class="swiper-slide ugc-video-slide">
            <div class="ugc-video-card" role="button" tabindex="0" aria-label="Play Customer Video 4">
              <img src="../assets/ugc-customer-4.png" alt="Customer Video Review 4 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
              <div class="ugc-play-btn-circle" aria-hidden="true">
                <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                  <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#2C3452"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Video Slide 5 -->
          <div class="swiper-slide ugc-video-slide">
            <div class="ugc-video-card" role="button" tabindex="0" aria-label="Play Customer Video 5">
              <img src="../assets/ugc-customer-5.png" alt="Customer Video Review 5 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
              <div class="ugc-play-btn-circle" aria-hidden="true">
                <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                  <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#2C3452"/>
                </svg>
              </div>
            </div>
          </div>

        </div>

        <!-- Pagination Dots -->
        <div class="ugc-swiper-pagination swiper-pagination"></div>
      </div>
    </div>

    <!-- Bottom Secondary Button -->
    <a href="{{ section.settings.btn_link | default: '#results' }}" class="ugc-reviews-btn">
      <span>{{ section.settings.btn_text | default: "Read all 26,966 reviews" }}</span>
    </a>

  </div>
</section>

{% schema %}
{
  "name": "11 — Customer Videos UGC",
  "tag": "section",
  "class": "section-customer-videos-ugc",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Over 840,000+ Happy Customers Have Made The Switch"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real people, real bathrooms, real 10-minute results."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Read all 26,966 reviews"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "11 — Customer Videos UGC"
    }
  ]
}
{% endschema %}
