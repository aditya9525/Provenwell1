<!-- 11 — Customer Videos (UGC) Section -->
<section class="ugc-videos-section" id="customerVideosSection-{{ section.id }}" aria-labelledby="ugcVideosHeading-{{ section.id }}">
  <div class="ugc-videos-container">

    <!-- Section Heading -->
    <div class="ugc-videos-header">
      <h2 class="ugc-videos-title" id="ugcVideosHeading-{{ section.id }}">
        {{ section.settings.title | default: "Over 840,000+ Happy Customers Have Made The Switch" }}
      </h2>
      <p class="ugc-videos-subtitle">
        {{ section.settings.subtitle | default: "Real people, real bathrooms, real 10-minute results." }}
      </p>
    </div>

    <!-- Swiper Carousel Container for Customer Videos -->
    <div class="ugc-swiper-wrapper-outer">
      <div class="swiper ugc-videos-swiper" id="ugcVideosSwiper-{{ section.id }}">
        <div class="swiper-wrapper">

          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="swiper-slide ugc-video-slide" {{ block.shopify_attributes }}>
                <div class="ugc-video-card js-open-benefits-video" role="button" tabindex="0" aria-label="{{ block.settings.aria_label | default: 'Play Customer Video' | escape }}">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.aria_label | default: 'Customer Video Review' | escape }}" class="ugc-video-img" loading="lazy">
                  {%- else -%}
                    {%- assign default_img_index = forloop.index | modulo: 5 -%}
                    {%- case default_img_index -%}
                      {%- when 1 -%}
                        <img src="{{ 'ugc-customer-1.png' | asset_url }}" alt="Customer Video Review 1 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                      {%- when 2 -%}
                        <img src="{{ 'ugc-customer-2.png' | asset_url }}" alt="Customer Video Review 2 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                      {%- when 3 -%}
                        <img src="{{ 'ugc-customer-3.png' | asset_url }}" alt="Customer Video Review 3 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                      {%- when 4 -%}
                        <img src="{{ 'ugc-customer-4.png' | asset_url }}" alt="Customer Video Review 4 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                      {%- else -%}
                        <img src="{{ 'ugc-customer-5.png' | asset_url }}" alt="Customer Video Review 5 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                    {%- endcase -%}
                  {%- endif -%}
                  <div class="ugc-play-btn-circle" aria-hidden="true">
                    <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                      <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#4A2346"/>
                    </svg>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback 5 Default Customer Video Slides -->
            <div class="swiper-slide ugc-video-slide">
              <div class="ugc-video-card js-open-benefits-video" role="button" tabindex="0" aria-label="Play Customer Video 1">
                <img src="{{ 'ugc-customer-1.png' | asset_url }}" alt="Customer Video Review 1 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                <div class="ugc-play-btn-circle" aria-hidden="true">
                  <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                    <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#4A2346"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="swiper-slide ugc-video-slide">
              <div class="ugc-video-card js-open-benefits-video" role="button" tabindex="0" aria-label="Play Customer Video 2">
                <img src="{{ 'ugc-customer-2.png' | asset_url }}" alt="Customer Video Review 2 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                <div class="ugc-play-btn-circle" aria-hidden="true">
                  <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                    <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#4A2346"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="swiper-slide ugc-video-slide">
              <div class="ugc-video-card js-open-benefits-video" role="button" tabindex="0" aria-label="Play Customer Video 3">
                <img src="{{ 'ugc-customer-3.png' | asset_url }}" alt="Customer Video Review 3 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                <div class="ugc-play-btn-circle" aria-hidden="true">
                  <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                    <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#4A2346"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="swiper-slide ugc-video-slide">
              <div class="ugc-video-card js-open-benefits-video" role="button" tabindex="0" aria-label="Play Customer Video 4">
                <img src="{{ 'ugc-customer-4.png' | asset_url }}" alt="Customer Video Review 4 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                <div class="ugc-play-btn-circle" aria-hidden="true">
                  <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                    <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#4A2346"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="swiper-slide ugc-video-slide">
              <div class="ugc-video-card js-open-benefits-video" role="button" tabindex="0" aria-label="Play Customer Video 5">
                <img src="{{ 'ugc-customer-5.png' | asset_url }}" alt="Customer Video Review 5 - Polar Hair Dye" class="ugc-video-img" loading="lazy">
                <div class="ugc-play-btn-circle" aria-hidden="true">
                  <svg width="18" height="21" viewBox="0 0 18 21" fill="none">
                    <path d="M17 10.5L1 19.5981L1 1.40192L17 10.5Z" fill="#4A2346"/>
                  </svg>
                </div>
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>

    <!-- Bottom Secondary Button -->
    <a href="{{ section.settings.btn_link | default: '#reviews' }}" class="ugc-reviews-btn">
      <span>{{ section.settings.btn_text | default: "Read all 26,966 reviews" }}</span>
    </a>

  </div>
</section>

<script>
  (function() {
    function initUgcSwiper() {
      var container = document.getElementById('ugcVideosSwiper-{{ section.id }}');
      if (!container || typeof Swiper === 'undefined') return;
      if (container.swiper) return;

      new Swiper(container, {
        slidesPerView: 2.15,
        spaceBetween: 12,
        grabCursor: true,
        watchOverflow: true,
        breakpoints: {
          520: {
            slidesPerView: 2.5,
            spaceBetween: 14
          },
          769: {
            slidesPerView: 3.5,
            spaceBetween: 16
          },
          1025: {
            slidesPerView: 5,
            spaceBetween: 20,
            allowTouchMove: false
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initUgcSwiper);
    } else {
      initUgcSwiper();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target && e.target.querySelector('#ugcVideosSwiper-{{ section.id }}')) {
        initUgcSwiper();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Customer Videos UGC",
  "tag": "section",
  "class": "section-customer-videos-ugc",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Over 840,000+ Happy Customers Have Made The Switch"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real people, real bathrooms, real 10-minute results."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Read all 26,966 reviews"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Customer Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Accessibility Label",
          "default": "Play Customer Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Videos UGC",
      "blocks": [
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" }
      ]
    }
  ]
}
{% endschema %}
