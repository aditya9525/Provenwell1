{%- comment -%}
  Shopify Section: AS SEEN IN Media Marquee
  Features customizable title, infinite smooth marquee scrolling, custom background gradient, and editable logos.
{%- endcomment -%}

{%- if section.settings.enable_section -%}
  <section class="as-seen-in-bar" id="as-seen-in-{{ section.id }}" aria-label="Featured In Publications">
    <div class="as-seen-in-wrapper">
      
      <!-- Label -->
      {%- if section.settings.heading != blank -%}
        <div class="as-seen-label-col">
          <span class="as-seen-text">{{ section.settings.heading | escape }}</span>
        </div>
      {%- endif -%}

      <!-- Infinite Marquee Viewport -->
      <div class="marquee-viewport">
        <div class="marquee-track" style="animation-duration: {{ section.settings.speed | default: 30 }}s;">
          
          <!-- Loop 1 -->
          <div class="marquee-group">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.image != blank -%}
                  <span class="media-logo" {{ block.shopify_attributes }}>
                    <img src="{{ block.settings.image | image_url: height: 48 }}" alt="{{ block.settings.title | default: 'Media Logo' | escape }}" height="24">
                  </span>
                {%- elsif block.settings.title != blank -%}
                  <span class="media-logo-text" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <span class="media-logo logo-vogue" title="VOGUE">
                <svg viewBox="0 0 110 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', 'Cinzel', serif" font-size="24" font-weight="700" letter-spacing="4">VOGUE</text></svg>
              </span>
              <span class="media-logo logo-instyle" title="InStyle">
                <svg viewBox="0 0 95 24" fill="#FFFFFF"><text x="0" y="19" font-family="'Lato', sans-serif" font-size="21" font-weight="700" letter-spacing="-0.5">InStyle</text></svg>
              </span>
              <span class="media-logo logo-gq" title="GQ">
                <svg viewBox="0 0 50 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Impact', 'Arial Black', sans-serif" font-size="24" font-weight="900" letter-spacing="1">GQ</text></svg>
              </span>
              <span class="media-logo logo-elle" title="ELLE">
                <svg viewBox="0 0 80 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', serif" font-size="24" font-weight="400" letter-spacing="6">ELLE</text></svg>
              </span>
              <span class="media-logo logo-vogue" title="VOGUE">
                <svg viewBox="0 0 110 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', 'Cinzel', serif" font-size="24" font-weight="700" letter-spacing="4">VOGUE</text></svg>
              </span>
              <span class="media-logo logo-instyle" title="InStyle">
                <svg viewBox="0 0 95 24" fill="#FFFFFF"><text x="0" y="19" font-family="'Lato', sans-serif" font-size="21" font-weight="700" letter-spacing="-0.5">InStyle</text></svg>
              </span>
              <span class="media-logo logo-gq" title="GQ">
                <svg viewBox="0 0 50 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Impact', 'Arial Black', sans-serif" font-size="24" font-weight="900" letter-spacing="1">GQ</text></svg>
              </span>
              <span class="media-logo logo-elle" title="ELLE">
                <svg viewBox="0 0 80 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', serif" font-size="24" font-weight="400" letter-spacing="6">ELLE</text></svg>
              </span>
            {%- endif -%}
          </div>

          <!-- Loop 2 (Seamless Duplicate) -->
          <div class="marquee-group" aria-hidden="true">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.image != blank -%}
                  <span class="media-logo">
                    <img src="{{ block.settings.image | image_url: height: 48 }}" alt="{{ block.settings.title | default: 'Media Logo' | escape }}" loading="lazy">
                  </span>
                {%- elsif block.settings.title != blank -%}
                  <span class="media-logo-text">{{ block.settings.title | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <span class="media-logo logo-vogue" title="VOGUE">
                <svg viewBox="0 0 110 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', 'Cinzel', serif" font-size="24" font-weight="700" letter-spacing="4">VOGUE</text></svg>
              </span>
              <span class="media-logo logo-instyle" title="InStyle">
                <svg viewBox="0 0 95 24" fill="#FFFFFF"><text x="0" y="19" font-family="'Lato', sans-serif" font-size="21" font-weight="700" letter-spacing="-0.5">InStyle</text></svg>
              </span>
              <span class="media-logo logo-gq" title="GQ">
                <svg viewBox="0 0 50 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Impact', 'Arial Black', sans-serif" font-size="24" font-weight="900" letter-spacing="1">GQ</text></svg>
              </span>
              <span class="media-logo logo-elle" title="ELLE">
                <svg viewBox="0 0 80 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', serif" font-size="24" font-weight="400" letter-spacing="6">ELLE</text></svg>
              </span>
              <span class="media-logo logo-vogue" title="VOGUE">
                <svg viewBox="0 0 110 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', 'Cinzel', serif" font-size="24" font-weight="700" letter-spacing="4">VOGUE</text></svg>
              </span>
              <span class="media-logo logo-instyle" title="InStyle">
                <svg viewBox="0 0 95 24" fill="#FFFFFF"><text x="0" y="19" font-family="'Lato', sans-serif" font-size="21" font-weight="700" letter-spacing="-0.5">InStyle</text></svg>
              </span>
              <span class="media-logo logo-gq" title="GQ">
                <svg viewBox="0 0 50 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Impact', 'Arial Black', sans-serif" font-size="24" font-weight="900" letter-spacing="1">GQ</text></svg>
              </span>
              <span class="media-logo logo-elle" title="ELLE">
                <svg viewBox="0 0 80 24" fill="#FFFFFF"><text x="0" y="20" font-family="'Didot', 'Bodoni MT', serif" font-size="24" font-weight="400" letter-spacing="6">ELLE</text></svg>
              </span>
            {%- endif -%}
          </div>

        </div>
      </div>

    </div>
  </section>

  <style>
    #as-seen-in-{{ section.id }} {
      width: 100%;
      background: {{ section.settings.bg_gradient | default: 'linear-gradient(90deg, #1C2438 0%, #25334D 50%, #1C2438 100%)' }};
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding: clamp(14px, 1.6vw, 18px) 0;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "As Seen In Marquee",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN IN"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Marquee scroll duration (lower is faster)",
      "default": 30
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(90deg, #1C2438 0%, #25334D 50%, #1C2438 100%)"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Media Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Publication Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen In Marquee"
    }
  ]
}
{% endschema %}
