{{ 'style.css' | asset_url | stylesheet_tag }}

{% style %}
  .promo-bar,
  .promo-bar-section {
    width: 100%;
    background-color: {{ section.settings.bg_color | default: '#465069' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: 'rgba(255, 255, 255, 0.08)' }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 990;
  }

  .promo-container {
    width: 100%;
    max-width: {{ section.settings.max_width | default: 1260 }}px;
    margin: 0 auto;
    padding: 10.5px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .promo-text {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 18px;
    text-align: center;
    letter-spacing: 1.05px;
    text-transform: uppercase;
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
    margin: 0;
  }

  .promo-link {
    text-decoration: none;
    color: inherit;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .promo-container {
      padding: 8px 14px;
    }
    .promo-text {
      font-size: 12px;
      line-height: 16px;
      letter-spacing: 0.8px;
    }
  }
{% endstyle %}

{%- if section.settings.show_promo and section.settings.text != blank -%}
  <div class="promo-bar promo-bar-section" role="region" aria-label="Promo">
    <div class="promo-container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="promo-link">
          <span class="promo-text">{{ section.settings.text | escape }}</span>
        </a>
      {%- else -%}
        <p class="promo-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Secondary Promo Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Promo text",
      "default": "SEE RESULTS IN 10' OR YOUR MONEY-BACK"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Promo link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#465069"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "rgba(255, 255, 255, 0.08)"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container max width",
      "default": 1260
    }
  ],
  "presets": [
    {
      "name": "Secondary Promo Bar"
    }
  ]
}
{% endschema %}
