{%- if section.settings.show_announcement and section.settings.text != blank -%}
  <div class="announcement-bar-section" id="announcement-bar-{{ section.id }}" role="region" aria-label="Announcement">
    <div class="announcement-container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-link">
          <span class="announcement-text">{{ section.settings.text | escape }}</span>
        </a>
      {%- else -%}
        <p class="announcement-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <style>
    #announcement-bar-{{ section.id }} {
      width: 100%;
      min-height: 41px;
      background-color: {{ section.settings.bg_color | default: '#1E2123' }};
      border-bottom: 1px solid {{ section.settings.border_color | default: 'rgba(244, 244, 244, 0.08)' }};
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      top: 0;
      left: 0;
      z-index: 1000;
    }

    #announcement-bar-{{ section.id }} .announcement-container {
      width: 100%;
      max-width: 1260px;
      padding: 0 20px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #announcement-bar-{{ section.id }} .announcement-text {
      font-family: 'Lato', var(--font-body-family, sans-serif);
      font-style: normal;
      font-weight: 400;
      font-size: 14.3px;
      line-height: 18px;
      text-align: center;
      letter-spacing: 1.05px;
      color: {{ section.settings.text_color | default: '#F4F4F4' }};
      padding: 10.5px 0;
      margin: 0;
      display: inline-block;
    }

    #announcement-bar-{{ section.id }} .announcement-link {
      text-decoration: none;
      color: inherit;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    #announcement-bar-{{ section.id }} .announcement-link:hover .announcement-text {
      opacity: 0.85;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "FALL SALE IS LIVE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1E2123"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "rgba(244, 244, 244, 0.08)"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
