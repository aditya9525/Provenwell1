{%- comment -%}
  Shopify Sticky Header Section
  Fully responsive with fluid max-width, Shopify Navigation, Currency/Country selector, and Cart
{%- endcomment -%}

<header class="site-header" id="siteHeader">
  <div class="header-container">
    
    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-menu-toggle" aria-label="Toggle navigation menu" id="mobileMenuToggle">
      <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Logo / Brand -->
    <div class="header-logo-wrapper">
      <a href="{{ routes.root_url }}" class="header-logo">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            loading="eager"
            class="brand-logo-img"
            style="max-width: {{ section.settings.logo_width | default: 130 }}px;"
          >
        {%- else -%}
          <svg class="brand-logo-svg" viewBox="0 0 140 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <text x="0" y="19" font-family="'Lato', sans-serif" font-size="20" font-weight="300" letter-spacing="4.5" fill="#000000">POLAR</text>
            <text x="2" y="29" font-family="'Lato', sans-serif" font-size="6.5" font-weight="400" letter-spacing="4.2" fill="#000000">HAIR CARE</text>
          </svg>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="header-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {%- if section.settings.menu != blank -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="nav-item">
              <a href="{{ link.url }}" class="nav-link{% if link.current or link.child_active %} active{% endif %}">
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Default fallback links -->
          <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
          <li class="nav-item"><a href="/products/instant-dye-shampoo" class="nav-link active">Instant Dye Shampoo</a></li>
          <li class="nav-item"><a href="/pages/help-center" class="nav-link">Help Center</a></li>
          <li class="nav-item"><a href="/pages/track-order" class="nav-link">Track Your Order</a></li>
          <li class="nav-item"><a href="/pages/contact" class="nav-link">Contact Us</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Header Actions (Localization & Cart) -->
    <div class="header-actions">
      
      <!-- Localization / Country & Currency Selector -->
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <div class="localization-selector">
          {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
            <div class="localization-btn">
              <span class="localization-text">{{ localization.country.name }} | {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</span>
              <svg class="chevron-icon" width="11" height="7" viewBox="0 0 11 7" fill="none">
                <path d="M1 1.25L5.5 5.75L10 1.25" stroke="#000000" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <!-- Visitor Country Flag Icon -->
              <span class="flag-icon" title="{{ localization.country.name }}">
                <svg viewBox="0 0 36 36" width="22" height="22" xmlns="http://www.w3.org/2000/svg">
                  <clipPath id="circle-clip-header">
                    <circle cx="18" cy="18" r="18" />
                  </clipPath>
                  <g clip-path="url(#circle-clip-header)">
                    <rect width="36" height="12" fill="#FF9933"/>
                    <rect y="12" width="36" height="12" fill="#FFFFFF"/>
                    <rect y="24" width="36" height="12" fill="#138808"/>
                    <circle cx="18" cy="18" r="4.5" fill="none" stroke="#000080" stroke-width="0.9"/>
                    <circle cx="18" cy="18" r="1.1" fill="#000080"/>
                    <line x1="18" y1="13.8" x2="18" y2="22.2" stroke="#000080" stroke-width="0.5"/>
                    <line x1="13.8" y1="18" x2="22.2" y2="18" stroke="#000080" stroke-width="0.5"/>
                    <line x1="15" y1="15" x2="21" y2="21" stroke="#000080" stroke-width="0.5"/>
                    <line x1="15" y1="21" x2="21" y2="15" stroke="#000080" stroke-width="0.5"/>
                  </g>
                </svg>
              </span>
            </div>
          {%- endform -%}
        </div>
      {%- else -%}
        <div class="localization-selector">
          <div class="localization-btn">
            <span class="localization-text">India | INR &#8377;</span>
            <svg class="chevron-icon" width="11" height="7" viewBox="0 0 11 7" fill="none">
              <path d="M1 1.25L5.5 5.75L10 1.25" stroke="#000000" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="flag-icon" title="India">
              <svg viewBox="0 0 36 36" width="22" height="22" xmlns="http://www.w3.org/2000/svg">
                <clipPath id="circle-clip-fallback">
                  <circle cx="18" cy="18" r="18" />
                </clipPath>
                <g clip-path="url(#circle-clip-fallback)">
                  <rect width="36" height="12" fill="#FF9933"/>
                  <rect y="12" width="36" height="12" fill="#FFFFFF"/>
                  <rect y="24" width="36" height="12" fill="#138808"/>
                  <circle cx="18" cy="18" r="4.5" fill="none" stroke="#000080" stroke-width="0.9"/>
                  <circle cx="18" cy="18" r="1.1" fill="#000080"/>
                  <line x1="18" y1="13.8" x2="18" y2="22.2" stroke="#000080" stroke-width="0.5"/>
                  <line x1="13.8" y1="18" x2="22.2" y2="18" stroke="#000080" stroke-width="0.5"/>
                  <line x1="15" y1="15" x2="21" y2="21" stroke="#000080" stroke-width="0.5"/>
                  <line x1="15" y1="21" x2="21" y2="15" stroke="#000080" stroke-width="0.5"/>
                </g>
              </svg>
            </span>
          </div>
        </div>
      {%- endif -%}

      <!-- Cart Icon Link -->
      <a href="{{ routes.cart_url }}" class="header-cart-btn" aria-label="Cart">
        <svg class="cart-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count" style="display: flex;">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer" id="mobileDrawer">
  <div class="mobile-drawer-header">
    <span class="mobile-drawer-title">Menu</span>
    <button class="mobile-drawer-close" id="mobileDrawerClose" aria-label="Close menu">&times;</button>
  </div>
  <ul class="mobile-nav-list">
    {%- if section.settings.menu != blank -%}
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}" class="mobile-nav-link{% if link.current or link.child_active %} active{% endif %}">
            {{ link.title | escape }}
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      <li><a href="/" class="mobile-nav-link">Home</a></li>
      <li><a href="/products/instant-dye-shampoo" class="mobile-nav-link active">Instant Dye Shampoo</a></li>
      <li><a href="/pages/help-center" class="mobile-nav-link">Help Center</a></li>
      <li><a href="/pages/track-order" class="mobile-nav-link">Track Your Order</a></li>
      <li><a href="/pages/contact" class="mobile-nav-link">Contact Us</a></li>
    {%- endif -%}
  </ul>
</div>
<div class="drawer-overlay" id="drawerOverlay"></div>

<script>
  (function() {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.getElementById('drawerOverlay');
    const closeBtn = document.getElementById('mobileDrawerClose');

    function openNav() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeNav() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', openNav);
    closeBtn?.addEventListener('click', closeNav);
    overlay?.addEventListener('click', closeNav);
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Custom logo width",
      "default": 130
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F4F4F4"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
